Subject: Make cargo binary path configurable

---
 Makefile | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

--- a/Makefile
+++ b/Makefile
@@ -92,7 +92,7 @@
 endif
 
 $(LIBRARY_RELEASE_$(OS)): $(INIT_BINARY)
